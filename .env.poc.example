# Copiar como .env.poc. Nunca versionar el archivo con valores reales.

APP_ENV=staging
PORT=8000
API_KEYS=CHANGE_ME_USER:user,CHANGE_ME_AGENT:agent,CHANGE_ME_ADMIN:admin
CORS_ORIGINS=http://localhost:8000

# PoC local: razonamiento determinista y persistencia local.
LLM_PROVIDER=mock
STORAGE_BACKEND=file
DATA_DIR=/app/data

# ServiceTonic Valtre
TICKETING_PROVIDER=servicetonic
SERVICETONIC_BASE_URL=https://valtre.myservicetonic.com/ServiceTonic
SERVICETONIC_PROJECT_ID=CHANGE_ME_PROJECT_ID
SERVICETONIC_USERNAME=CHANGE_ME_TECHNICAL_USER
SERVICETONIC_PASSWORD=CHANGE_ME_PASSWORD
SERVICETONIC_TEAM=CHANGE_ME_TEAM
SERVICETONIC_AUTH_PREFIX=
# Sustituir nombres por los campos reales de la plantilla Valtre.
SERVICETONIC_FIELD_MAP='{"number":"ticketNumber","title":"title","description":"description","state":"status","priority":"priority","category":"category","subcategory":"subcategory","caller":"contact"}'

# Manager fijo de la demostración; el bot resuelve su aadObjectId con Graph.
POC_MANAGER_NAME=CHANGE_ME_MANAGER_NAME
POC_MANAGER_EMAIL=CHANGE_ME_MANAGER_EMAIL

# Teams Bot: requerido para botones interactivos Aprobar/Rechazar.
NOTIFY_CHANNEL=teams
TEAMS_BOT_APP_ID=CHANGE_ME_APPLICATION_ID
TEAMS_BOT_APP_PASSWORD=CHANGE_ME_CLIENT_SECRET
TEAMS_TENANT_ID=CHANGE_ME_TENANT_ID
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/

# URL HTTPS pública del túnel local. Configurarla como messaging endpoint:
# <PUBLIC_BASE_URL>/api/teams/messages
PUBLIC_BASE_URL=CHANGE_ME_HTTPS_TUNNEL_URL
