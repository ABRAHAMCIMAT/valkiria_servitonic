# ===== Entorno =====
APP_ENV=development              # development | staging | production

# ===== Seguridad (Fase 0) =====
# Formato: clave:rol separadas por coma. Roles: user | agent | admin
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ===== Rutas de datos (relativas, no absolutas) =====
DATA_DIR=backend/data
LOG_FILE=
TELEMETRY_LOG=
CONV_STORE=
AUDIT_LOG=
LOG_LEVEL=INFO
TELEMETRY_MAX_EVENTS=5000
# Privacidad: por defecto el contenido del usuario NO se registra.
# Pon true solo en depuracion local (se registra redactado de PII).
LOG_USER_CONTENT=false

# ===== LLM (modelo-agnostico) =====
LLM_PROVIDER=jan                 # jan | openai | vertex | mock
LLM_BASE_URL=http://localhost:1337/v1
LLM_MODEL=gpt-oss:latest
LLM_API_KEY=

# ===== Google Cloud (Fase 2) =====
# Vertex AI no usa API key: autentica con ADC (en local:
# `gcloud auth application-default login`; en Cloud Run: la cuenta de servicio).
GCP_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=google/gemini-2.5-flash
# file (local, una instancia) | firestore (Cloud Run, varias instancias)
STORAGE_BACKEND=file
FIRESTORE_DATABASE=(default)
FIRESTORE_TTL_DAYS=90
# Horas que una aprobacion espera respuesta antes de expirar y escalar
APPROVAL_TTL_HOURS=72

# ===== Sistema de tickets =====
# servicenow (actual) | servicetonic (pendiente de requerimientos, plan I5)
TICKETING_PROVIDER=servicenow

# ===== ServiceNow =====
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASSWORD=
SNOW_TOKEN=

# ===== Notificaciones =====
NOTIFY_CHANNEL=teams             # teams | slack | whatsapp
# Teams, opcion 1: bot (aprobaciones interactivas). Ver docs/integraciones/TEAMS.md
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/
# Teams, opcion 2: webhook de Workflows (Power Automate), solo avisos a un canal
TEAMS_WORKFLOW_URL=
# Legado (Slack / conectores de Office 365 retirados / WhatsApp)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WHATSAPP_API_URL=

# ===== Observabilidad (opcional) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Evaluación (opcional) =====
# Activa el check LLM-as-judge en el Agente de Conocimiento (cuesta una
# llamada LLM extra por consulta).
ENABLE_LLM_JUDGE=false

PORT=8000
