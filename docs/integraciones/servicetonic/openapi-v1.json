{
  "openapi": "3.0.1",
  "info": {
    "title": "ServiceTonic REST API Documentation",
    "description": "To invoke the following operations, previously you must be authenticated in the application, you must request the generation of a connection token.\n",
    "contact": {
      "name": "ServiceTonic",
      "email": "support@servicetonic.com"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "/ServiceTonic"
    }
  ],
  "security": [
    {
      "Authorization": []
    }
  ],
  "paths": {
    "/strest/v1/auth": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Generate authentication token",
        "description": "Authentication is based on tokens. These tokens are generated randomly by the platform at the time of requesting access to the service.\nThe obtained tokens must be sent together with the requests as an Authorization header that will allow the system to validate, authenticate and identify the origin of the request.",
        "operationId": "authenticateUser",
        "requestBody": {
          "description": "idProject: Remote service identifier.\nusername: Agent's username to authenticate in the remote ServiceTonic.\npassword: Agent's password encrypted in SHA-1 and Base64.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RSCredential"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Encrypted Authorization Token."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/cis": {
      "post": {
        "tags": [
          "Configuration Items Administration"
        ],
        "summary": "Create a new configuration item (ci)",
        "description": "This operation allows you to create a new ci in a specific service of a Remote ServiceTonic.\nTo do this, it takes as input a MULTIPART_FORM_DATA that can contain ci attachments and a list of contacts related to the ci, as well as a JSON with the ci information to be created.",
        "operationId": "createCi",
        "parameters": [
          {
            "name": "rsConfigurationItem",
            "in": "query",
            "description": "Ci information as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "object",
                    "description": "Ci files to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created ci id."
          },
          "400": {
            "description": "No ci data, \nNot related Cmdb, \nNo ci title found, \nNo ci status found, \nCi status does not exist, \nNo ci type found, \nCi type does not exist, \nNo ci serial number found, \nCi serial number already exists, \nNot valid agent, \nAgent does not have create permission."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/cis/{idCiCmdb}": {
      "put": {
        "tags": [
          "Configuration Items Administration"
        ],
        "summary": "Update an existing configuration item (ci)",
        "description": "This operation allows modifying a ci of a certain service of a Remote ServiceTonic.\nFor this, it takes as input a MULTIPART_FORM_DATA that can contain ci attachments and a list of contacts related to the ci, as well as a JSON with the ci information to be modified.",
        "operationId": "updateCi",
        "parameters": [
          {
            "name": "rsConfigurationItem",
            "in": "query",
            "description": "Ci information as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "idCiCmdb",
            "in": "path",
            "description": "Internal numeric identifier of a ci from the service.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "object",
                    "description": "Ci files to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated ci id."
          },
          "400": {
            "description": "No ci data, \nNot related Cmdb, \nCi does not exist, \nNot valid agent, \nAgent does not have modify permission."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/cis/sn": {
      "put": {
        "tags": [
          "Configuration Items Administration"
        ],
        "summary": "Update an existing configuration item (ci)",
        "description": "This operation allows modifying a ci of a certain service of a Remote ServiceTonic.\nFor this, it takes as input a MULTIPART_FORM_DATA that can contain ci attachments and a list of contacts related to the ci, as well as a JSON with the ci information to be modified.",
        "operationId": "updateCiWithSerial",
        "parameters": [
          {
            "name": "rsConfigurationItem",
            "in": "query",
            "description": "Ci information as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "serialNumber",
            "in": "query",
            "description": "Serial number of a ci from the service.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "object",
                    "description": "Ci files to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated ci serial."
          },
          "400": {
            "description": "No ci data, \nNot related Cmdb, \nCi does not exist, \nNot valid agent, \nAgent does not have modify permission."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/contacts": {
      "post": {
        "tags": [
          "Contact Administration"
        ],
        "summary": "Create a new contact",
        "description": "This operation allows creating a new contact in the internal list of the contact template associated with the service reported in a remote ServiceTonic.\nTo do this, it takes as input a MULTIPART_FORM_DATA that can contain an image with the contact's photo as well as a JSON with the contact information to create.",
        "operationId": "createContact",
        "parameters": [
          {
            "name": "rsContact",
            "in": "query",
            "description": "Contact information as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "object",
                    "description": "Contact photo to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact created."
          },
          "400": {
            "description": "No contact data, \nContact already exists."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/contacts/{identContact}": {
      "put": {
        "tags": [
          "Contact Administration"
        ],
        "summary": "Update an existing contact",
        "description": "This operation allows you to modify an existing contact in the internal list of the contact template associated with the reported service in a remote ServiceTonic .\nTo do this, it takes as input a MULTIPART_FORM_DATA that can contain an image with the contact's photo as well as a JSON with the contact information to be modified.",
        "operationId": "updateContact",
        "parameters": [
          {
            "name": "rsContact",
            "in": "query",
            "description": "Contact information as JSON.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "identContact",
            "in": "path",
            "description": "Identifier of a ServiceTonic contact/user.\nIt will be a value of the contact identifier field defined in the contact template associated with the remote service.",
            "required": true,
            "schema": {
              "pattern": ".+",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "object",
                    "description": "Contact photo to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact updated."
          },
          "400": {
            "description": "No contact data, \nContact not found."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      },
      "delete": {
        "tags": [
          "Contact Administration"
        ],
        "summary": "Delete an existing contact",
        "description": "This operation allows you to delete an existing contact in the internal list of the contact template associated with the reported service in a remote ServiceTonic.",
        "operationId": "deleteContact",
        "parameters": [
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "identContact",
            "in": "path",
            "description": "Identifier of a ServiceTonic contact/user.\nIt will be a value of the contact identifier field defined in the contact template associated with the remote service.",
            "required": true,
            "schema": {
              "pattern": ".+",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact deleted."
          },
          "400": {
            "description": "No contact data, \nContact not found."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
    "/strest/v1/services/{idProject}/contacts/list": {
      "post": {
        "tags": [
