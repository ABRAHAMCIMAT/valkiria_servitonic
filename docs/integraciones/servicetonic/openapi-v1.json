        "operationId": "addAction",
        "parameters": [
          {
            "name": "rsAction",
            "in": "query",
            "description": "Action information as JSON",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idProject",
            "in": "path",
            "description": "Internal numeric identifier of a service from a ServiceTonic installation.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "idIncident",
            "in": "path",
